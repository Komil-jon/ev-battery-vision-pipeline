# OS / IDE
.DS_Store
.idea/
*.swp

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Conda installer (do not commit large binaries)
Miniconda3-*.sh

# YOLO / training artefacts
*.cache
runs/
outputs/
data/classifier/to_sort/

# Raw dataset (download via scripts/download_dataset.py)
EV-Battery-pack--1/
data/detector/images/
data/detector/labels/
data/classifier/train/

# External / harvested / generated data (regenerate via scripts)
data/sources/
data/youtube_harvest/
data/detector_singlestage/
data/classifier/bad_synth/

# Local backups created by the maintenance scripts
.backup/

# Temporary lighting-evaluation workspace
/tmp/ev_lighting_eval/

# Local-only benchmark artifacts (regenerate)
dataset_bench.yaml
dataset_aug.yaml
yolo11n.pt
models/detector/arch_benchmark/
*.onnx

# RF-DETR checkpoint exceeds GitHub's 100MB limit -- fetch separately
models/detector/generalist_rfdetr/weights/*.pth

# Ultralytics training-batch mosaics (regenerable augmentation previews)
models/**/train_batch*.jpg
models/**/val_batch*.jpg
# Pretrained base checkpoints (auto-downloaded by ultralytics on first use)
yolov8n.pt
yolo11n.pt
yolov8s-worldv2.pt
sam2.1_b.pt
mobile_sam.pt

# LaTeX build artefacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.xdv
paper/*.bbl
paper/*.blg

# SCITEPRESS publisher style files (redistributed from scitepress.org, not ours)
paper/detection/SCITEPRESS.sty
paper/detection/apalike.sty
paper/detection/apalike.bst
paper/detection/article.cls
paper/detection/SCITEPRESS.eps
paper/detection/orcid.png
paper/detection/orcid.eps

# Compiled manuscripts: VISAPP prohibits public posting of papers under review.
# Sources are tracked; built PDFs stay local until the decision is announced.
paper/detection/*.pdf
paper/*.pdf
!paper/detection/figures/*.pdf
!paper/figures/*.pdf
